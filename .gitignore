# Node / Vite
node_modules/
dist/
dist-ssr/

# Exception: the Chrome extension's content-script bundle is generated, but Chrome loads it
# directly from the unpacked folder, so it has to be committed. Regenerate with
# `node extension/tools/build.mjs`; `--check` fails if it is stale.
!extension/dist/
!extension/dist/content.bundle.js
.vite/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

